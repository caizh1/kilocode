{
  "name": "chipmate-patent-server",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node script/copy-build-assets.mjs",
    "dev": "tsx src/start.ts",
    "start": "node dist/src/start.js",
    "patentctl": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "pg": "8.16.3",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
