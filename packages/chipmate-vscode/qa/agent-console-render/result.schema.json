{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChipMate Agent Console macOS render proxy result",
  "type": "object",
  "required": ["generatedAt", "lane", "status", "attempts", "environment", "limitations"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "lane": { "const": "macos-source-render-proxy" },
    "status": { "enum": ["PASS", "FAIL", "FLAKY", "REVIEW", "BLOCKED"] },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["number", "status", "cases"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 3 },
          "status": { "enum": ["PASS", "FAIL", "REVIEW", "BLOCKED"] },
          "cases": { "type": "array", "minItems": 8, "maxItems": 8 }
        }
      }
    }
  }
}
