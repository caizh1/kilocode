# ChipMate Agent Console shell integration for Ubuntu/Debian Bash.
# Load the user's interactive configuration first so aliases, PATH, prompt,
# virtual environments, and other shell state behave like a normal terminal.
if [[ -r "$HOME/.bashrc" ]]; then
  source "$HOME/.bashrc"
fi

__chipmate_token="${KILO_AGENT_CONSOLE_TOKEN-}"
unset KILO_AGENT_CONSOLE KILO_AGENT_CONSOLE_TOKEN

if [[ "$__chipmate_token" =~ ^[a-fA-F0-9]{32}$ ]]; then
  __chipmate_emit() {
    printf '\033]6973;%s;%s\a' "$__chipmate_token" "$1"
  }

  __chipmate_cwd() {
    printf '%s' "$PWD" | base64 | tr -d '\n'
  }

  __chipmate_capture() {
    local request="$1"
    local input="${READLINE_LINE-}"
    local first=""
    local known=0
    local encoded=""
    [[ "$request" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] || return
    first="${input#"${input%%[![:space:]]*}"}"
    first="${first%%[[:space:];&|<>]*}"
    first="${first#\&}"
    first="${first#\'}"
    first="${first%\'}"
    first="${first#\"}"
    first="${first%\"}"
    if [[ -n "$first" ]] && type -t -- "$first" >/dev/null 2>&1; then
      known=1
    fi
    encoded="$(printf '%s' "$input" | base64 | tr -d '\n')"
    __chipmate_current="$request"
    __chipmate_emit "input;${request};${known};${encoded}"
  }

  __chipmate_clear() {
    READLINE_LINE=""
    READLINE_POINT=0
  }

  __chipmate_bind_agent() {
    __chipmate_agent_mode=1
    bind -x '"\C-m":__chipmate_ignore'
  }

  __chipmate_ignore() {
    :
  }

  __chipmate_request=""
  __chipmate_current=""
  __chipmate_pending=""
  __chipmate_request_reset() {
    __chipmate_request=""
  }

  __chipmate_request_digit() {
    if (( ${#__chipmate_request} < 32 )); then
      __chipmate_request+="$1"
    fi
  }

  __chipmate_request_apply() {
    local raw="$__chipmate_request"
    __chipmate_request=""
    [[ "$raw" =~ ^[0-9a-fA-F]{32}$ ]] || return
    __chipmate_capture "${raw:0:8}-${raw:8:4}-${raw:12:4}-${raw:16:4}-${raw:20:12}"
  }

  __chipmate_applied() {
    local route="$1"
    local request="$__chipmate_current"
    [[ "$request" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] || return
    __chipmate_current=""
    __chipmate_emit "applied;${request};${route}"
  }

  __chipmate_agent_apply() {
    __chipmate_clear
    __chipmate_pending="$__chipmate_current"
    __chipmate_current=""
  }

  __chipmate_shell_apply() {
    __chipmate_applied shell
  }

  __chipmate_agent_on() {
    __chipmate_bind_agent
    __chipmate_emit "ready;$(__chipmate_cwd)"
    if [[ "$__chipmate_pending" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]]; then
      local request="$__chipmate_pending"
      __chipmate_pending=""
      __chipmate_emit "applied;${request};agent"
    fi
  }

  __chipmate_agent_off() {
    __chipmate_agent_mode=0
    bind '"\C-m":accept-line'
    __chipmate_emit "ready;$(__chipmate_cwd)"
  }

  __chipmate_begin() {
    __chipmate_emit "begin;$(__chipmate_cwd)"
  }

  __chipmate_first=1
  __chipmate_after() {
    local code=$?
    if (( __chipmate_first )); then
      __chipmate_emit "prompt;$(__chipmate_cwd)"
      __chipmate_first=0
      return "$code"
    fi
    __chipmate_emit "end;${code};$(__chipmate_cwd)"
    return "$code"
  }

  __chipmate_prompt=()
  case "$(declare -p PROMPT_COMMAND 2>/dev/null)" in
    "declare -a"*) __chipmate_prompt=("${PROMPT_COMMAND[@]}") ;;
    *)
      if [[ -n "${PROMPT_COMMAND-}" ]]; then
        __chipmate_prompt=("$PROMPT_COMMAND")
      fi
      ;;
  esac

  __chipmate_ps0="${PS0-}"
  __chipmate_agent_mode=1
  __chipmate_install() {
    PROMPT_COMMAND=(__chipmate_after "${__chipmate_prompt[@]}")
    PS0='$(__chipmate_begin)'"${__chipmate_ps0}"
    bind '"\C-x\C-e":accept-line'
    bind -x '"\C-x\C-a":__chipmate_agent_on'
    bind -x '"\C-x\C-h":__chipmate_agent_off'
    bind -x '"\C-x\C-u":__chipmate_clear'
    bind -x '"\C-x\C-y":__chipmate_agent_apply'
    bind -x '"\C-x\C-n":__chipmate_shell_apply'
    bind -x '"\C-x\C-r":__chipmate_request_reset'
    bind -x '"\C-x0":__chipmate_request_digit 0'
    bind -x '"\C-x1":__chipmate_request_digit 1'
    bind -x '"\C-x2":__chipmate_request_digit 2'
    bind -x '"\C-x3":__chipmate_request_digit 3'
    bind -x '"\C-x4":__chipmate_request_digit 4'
    bind -x '"\C-x5":__chipmate_request_digit 5'
    bind -x '"\C-x6":__chipmate_request_digit 6'
    bind -x '"\C-x7":__chipmate_request_digit 7'
    bind -x '"\C-x8":__chipmate_request_digit 8'
    bind -x '"\C-x9":__chipmate_request_digit 9'
    bind -x '"\C-xa":__chipmate_request_digit a'
    bind -x '"\C-xb":__chipmate_request_digit b'
    bind -x '"\C-xc":__chipmate_request_digit c'
    bind -x '"\C-xd":__chipmate_request_digit d'
    bind -x '"\C-xe":__chipmate_request_digit e'
    bind -x '"\C-xf":__chipmate_request_digit f'
    bind -x '"\C-x\C-p":__chipmate_request_apply'
    if (( __chipmate_agent_mode )); then
      __chipmate_bind_agent
    else
      bind '"\C-m":accept-line'
    fi
  }

  __chipmate_resync() {
    __chipmate_install
    __chipmate_emit "resync;$(__chipmate_cwd)"
  }

  __chipmate_install
fi
