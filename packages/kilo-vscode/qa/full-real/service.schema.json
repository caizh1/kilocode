{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChipMate Service atomic case catalog",
  "type": "object",
  "required": ["version", "generatedAt", "cases"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "suite",
          "title",
          "preconditions",
          "action",
          "expected",
          "auth",
          "method",
          "path",
          "sideEffect",
          "cleanup",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^SVC-[A-Z]+-[0-9]{2}$" },
          "suite": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "action": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "auth": { "enum": ["anonymous", "owner", "non-owner", "invalid"] },
          "method": { "enum": ["GET", "POST", "PUT", "DELETE"] },
          "path": { "type": "string", "minLength": 1 },
          "sideEffect": { "type": "string", "minLength": 1 },
          "cleanup": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
