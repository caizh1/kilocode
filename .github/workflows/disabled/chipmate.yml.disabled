name: chipmate

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  chipmate:
    if: |
      (github.event.comment.author_association == 'MEMBER' || github.event.comment.author_association == 'OWNER') &&
      (
        contains(github.event.comment.body, ' /kc') ||
        startsWith(github.event.comment.body, '/kc') ||
        contains(github.event.comment.body, ' /chipmate') ||
        startsWith(github.event.comment.body, '/chipmate')
      )
    runs-on: blacksmith-4vcpu-ubuntu-2404
    permissions:
      id-token: write
      contents: read
      pull-requests: read
      issues: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - uses: ./.github/actions/setup-bun

      - name: Run opencode
        uses: ChipMate-Org/chipmate/github@latest
        env:
          CHIPMATE_API_KEY: ${{ secrets.CHIPMATE_API_KEY }}
          CHIPMATE_ORG_ID: ${{ secrets.CHIPMATE_ORG_ID }}
          CHIPMATE_PERMISSION: '{"bash": "deny"}'
        with:
          model: chipmate/chipmate-auto/frontier
