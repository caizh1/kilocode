# 服务端配置
CHIPMATE_BUG_HOST=127.0.0.1
CHIPMATE_BUG_PORT=8321
CHIPMATE_BUG_DB=/var/lib/chipmate-bug-manager/chipmate-bugs.sqlite
CHIPMATE_RELEASE_BASE=请设置为当前已发布的ChipMate版本
CHIPMATE_WORKER_TOKEN=请替换为至少32字符的随机值

# Mac 自动执行器配置
CHIPMATE_BUG_URL=https://106.14.118.87/bugs/
CHIPMATE_WORKER_ID=chipmate-mac-runner
CHIPMATE_RUNNER_MODE=monitor
CHIPMATE_REPO_DIR=/工作目录/chipmate-source
CHIPMATE_WORK_ROOT=/Users/archer/Work/chipmate-auto-worktrees
CHIPMATE_PUBLIC_PACKAGES=/绝对路径/public-packages
CHIPMATE_EXTENSION_DIR=packages/chipmate-extension
CHIPMATE_SNAPSHOT_PATHS='["packages",".changeset","script"]'
CHIPMATE_MAX_ROUNDS=3
CHIPMATE_MAX_TOKENS=0
CHIPMATE_TIMEOUT_MINUTES=90
CHIPMATE_CODEX_COMMAND='["bash","server/chipmate-bug-manager/deploy/run-codex-sandboxed.sh"]'
CHIPMATE_SANDBOX_COMMAND='["bash","server/chipmate-bug-manager/deploy/run-worktree-sandboxed.sh"]'
CHIPMATE_VERIFY_COMMAND='["bun","run","typecheck"]'
CHIPMATE_PACKAGE_COMMAND='["bun","server/chipmate-bug-manager/scripts/package-release.ts"]'
CHIPMATE_WINDOWS_QA_COMMAND='["bash","server/chipmate-bug-manager/scripts/qa-windows-arm.sh"]'
CHIPMATE_LINUX_QA_COMMAND='["bash","server/chipmate-bug-manager/scripts/qa-linux.sh"]'
CHIPMATE_PUBLISH_COMMAND='["/绝对路径/受保护发布命令"]'
CHIPMATE_WINDOWS_VM=Windows 11
CHIPMATE_LINUX_QA_DEST=chipmate-qa@106.14.118.87
CHIPMATE_WINDOWS_QA_ROOT=/Users/archer/Work/chipmate-auto-release
