{
  "name": "chipmate-bug-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "admin:create": "tsx src/admin.ts",
    "admin:create:prod": "node dist/server/admin.js",
    "invite:default": "tsx src/invite.ts",
    "invite:default:prod": "node dist/server/invite.js",
    "build": "npm run build:web && npm run build:server && npm run verify:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsx watch src/start.ts",
    "dev:web": "vite",
    "lint": "eslint src scripts test web vite.config.ts",
    "runner": "tsx src/runner.ts",
    "start": "node dist/server/start.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:web": "tsx scripts/verify-web-build.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "@phosphor-icons/react": "2.1.10",
    "fastify": "5.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "globals": "17.7.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "7.3.6"
  }
}
