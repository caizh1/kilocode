{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chipmate.local/qa/low-end/result.schema.json",
  "title": "ChipMate low-end proxy benchmark result",
  "type": "object",
  "required": ["generatedAt", "lane", "profile", "environment", "attempts", "status", "summary"],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "lane": { "enum": ["webview", "installed"] },
    "profile": {
      "type": "object",
      "required": ["id", "cpuRate", "network"],
      "properties": {
        "id": { "const": "2c-8gb-hdd-proxy" },
        "cpuRate": { "const": 6 },
        "network": { "type": "object" }
      },
      "additionalProperties": true
    },
    "environment": { "type": "object" },
    "artifact": { "type": ["object", "null"] },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["number", "status", "metrics", "evidence"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 2 },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "status", "samples", "unit", "summary"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "status": { "enum": ["PASS", "FAIL", "BLOCKED", "SKIP"] },
                "samples": { "type": "array", "items": { "type": "number" } },
                "unit": { "enum": ["ms", "bytes", "percent", "boolean"] },
                "budget": { "type": ["number", "null"] },
                "value": { "type": ["number", "null"] },
                "summary": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "evidence": { "type": "object" },
          "error": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "status": { "enum": ["PASS", "FAIL", "FLAKY", "BLOCKED"] },
    "summary": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
