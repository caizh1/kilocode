{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chipmate.local/qa/windows-real/atomic.schema.json",
  "title": "ChipMate atomic regression assertions",
  "type": "object",
  "required": ["version", "generatedAt", "problems"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/problem" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["required", "executor", "state"],
      "properties": {
        "required": { "type": "boolean" },
        "executor": { "type": "string", "minLength": 1 },
        "state": { "enum": ["implemented", "planned"] }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["id", "title", "oracle", "evidence", "source", "macos", "windows"],
      "properties": {
        "id": { "type": "string", "pattern": "^REG-[A-Z0-9-]+-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 4 },
        "oracle": { "const": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "$ref": "#/$defs/lane" },
        "macos": { "$ref": "#/$defs/lane" },
        "windows": { "$ref": "#/$defs/lane" }
      },
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "required": ["changeset", "parent", "summary", "assertions"],
      "properties": {
        "changeset": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "parent": { "type": "string", "pattern": "^WIN-[A-Z0-9-]+$" },
        "summary": { "type": "string", "minLength": 1 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      },
      "additionalProperties": false
    }
  }
}
